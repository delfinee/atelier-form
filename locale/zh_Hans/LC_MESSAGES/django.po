#: .\frontend\mockdata\content.py:15
msgid "Handmade for everyday moments."
msgstr "手作之物，日常之用。"

#: .\frontend\mockdata\content.py:16
msgid ""
"Small-batch ceramics, textiles and homeware, made by hand by a short list of "
"makers we know by name."
msgstr "陶器、织物与器物，由五位我们熟识的匠人一件一件手工制成。"

#: .\frontend\mockdata\content.py:20
msgid "Unit 4, Lane 210 Taikang Road, Huangpu, Shanghai"
msgstr "上海市黄浦区泰康路210弄4号"

#: .\frontend\mockdata\content.py:21
msgid "Studio visits by appointment · Tuesday to Saturday, 10am–6pm"
msgstr "到访需预约 · 周二至周六 10:00–18:00"

