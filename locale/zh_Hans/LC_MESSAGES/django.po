msgstr "藤编 · 陆文静"

#: .\frontend\mockdata\products.py:307
msgid "Three pieces, wrapped · Multiple makers"
msgstr "三件作品，手工包裹 · 多位匠人"

#: .\frontend\mockdata\products.py:318
msgid "Pure beeswax · Xu Anying"
