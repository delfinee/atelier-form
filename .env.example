# Copy to `.env` and adjust. `.env` is gitignored -- never commit real secrets.

# -- Core -----------------------------------------------------------------
APP_ENV=development
DJANGO_DEBUG=1
# Set a stable, private value locally as well as in production. Leaving this
# blank generates a new key each process, invalidating reset links and sessions
# after a restart. Generate once: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Put the generated value only in your environment or gitignored .env, never here.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

# -- Database (REQUIRED) --------------------------------------------------
DATABASE_URL=postgres://atelier:atelier@127.0.0.1:5432/atelier_form
# -- JWT ------------------------------------------------------------------
# Falls back to DJANGO_SECRET_KEY when blank.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# -- CORS -----------------------------------------------------------------
# Only needed for a separate front-end origin. The frontend is same-origin,
# so this stays empty. Never use "*" together with credentials.
CORS_ALLOWED_ORIGINS=

# -- Commerce -------------------------------------------------------------
CURRENCY=CNY
# Optional. Defaults to the symbol for CURRENCY; set only to override it.
# CURRENCY_SYMBOL=$
FREE_SHIPPING_THRESHOLD=80
SHIPPING_STANDARD=8
SHIPPING_EXPRESS=18
LOW_STOCK_THRESHOLD=5
ORDER_NUMBER_PREFIX=AF

# -- Pluggable services ---------------------------------------------------
# Swap for a real provider later; no API key is needed by either default.
PAYMENT_BACKEND=payments.services.MockPaymentProvider
PAYMENT_RESERVATION_MINUTES=30
EMAIL_BACKEND_CLASS=content.services.ConsoleEmailSender

# -- Django password-reset email (separate from EMAIL_BACKEND_CLASS) --------
# Local only: full emails, including reset links, appear in the server terminal.
# This is the default when DJANGO_DEBUG=1; no real email is delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Atelier Form <noreply@atelierform.test>
# Seconds; 259200 = 72 hours. Links also stop working after a successful reset.
PASSWORD_RESET_TIMEOUT=259200
# Real delivery: select django.core.mail.backends.smtp.EmailBackend above and
# configure a verified sender plus your provider's settings. Never use console
# email in production. Enable TLS or SSL according to your provider, not both.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10

# -- Localisation ---------------------------------------------------------
# zh-hans switches the frontend to Simplified Chinese once translations exist.
DJANGO_LANGUAGE_CODE=en-us

# -- Production only ------------------------------------------------------
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=2592000

# Required behind a TLS-terminating proxy (Vercel, Render, any CDN), or every
# form POST is rejected with 403. Comma-separated, scheme included.
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# Serverless hosts must not keep connections open between invocations; set 0
# there and point DATABASE_URL at a pooled connection string.
# DJANGO_CONN_MAX_AGE=0

# Seller assistant: one backend for the website and seller Mini Program.
SELLER_AGENT_ENABLED=1
# Guided commands work without model calls. Enable only with a server-side key.
SELLER_AGENT_USE_LLM=0
SELLER_AGENT_MODEL=deepseek-flash
SELLER_AGENT_API_KEY=
# If empty, the seller assistant can reuse DEEPSEEK_API_KEY below.
# Maximum external model requests per UTC day across this deployment.
SELLER_AGENT_LLM_DAILY_LIMIT=500
WECHAT_SELLER_ENABLED=0
WECHAT_SELLER_DEV_LOGIN=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Buyer website assistant. Keys stay server-side; guided discovery needs no key.
BUYER_ASSISTANT_ENABLED=1
BUYER_AI_USE_LLM=0
BUYER_AI_DAILY_LIMIT=500
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CONCIERGE_DEMO=0
