# Copy to `.env` and adjust. `.env` is gitignored -- never commit real secrets.

# -- Core -----------------------------------------------------------------
APP_ENV=development
DJANGO_DEBUG=1
# REQUIRED in production. Left blank in development, where an ephemeral
# per-process key is generated instead.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

# -- Database (REQUIRED) --------------------------------------------------
DATABASE_URL=postgres://atelier:atelier@127.0.0.1:5432/atelier_form
# -- JWT ------------------------------------------------------------------
# Falls back to DJANGO_SECRET_KEY when blank.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# -- CORS -----------------------------------------------------------------
# Only needed for a separate front-end origin. The frontend is same-origin,
# so this stays empty. Never use "*" together with credentials.
CORS_ALLOWED_ORIGINS=

# -- Commerce -------------------------------------------------------------
CURRENCY=CNY
# Optional. Defaults to the symbol for CURRENCY; set only to override it.
# CURRENCY_SYMBOL=$
FREE_SHIPPING_THRESHOLD=80
SHIPPING_STANDARD=8
SHIPPING_EXPRESS=18
LOW_STOCK_THRESHOLD=5
ORDER_NUMBER_PREFIX=AF

# -- Pluggable services ---------------------------------------------------
# Swap for a real provider later; no API key is needed by either default.
PAYMENT_BACKEND=payments.services.MockPaymentProvider
PAYMENT_RESERVATION_MINUTES=30
EMAIL_BACKEND_CLASS=content.services.ConsoleEmailSender

# -- Localisation ---------------------------------------------------------
# zh-hans switches the frontend to Simplified Chinese once translations exist.
DJANGO_LANGUAGE_CODE=en-us

# -- Production only ------------------------------------------------------
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=2592000

# Required behind a TLS-terminating proxy (Vercel, Render, any CDN), or every
# form POST is rejected with 403. Comma-separated, scheme included.
# CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app

# Serverless hosts must not keep connections open between invocations; set 0
# there and point DATABASE_URL at a pooled connection string.
# DJANGO_CONN_MAX_AGE=0
