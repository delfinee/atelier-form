<view class="page">
  <view class="intro"><text class="eyebrow">ATELIER FORM · SELLER</text><text class="title">用对话管理你的店铺</text><text class="muted">{{aiEnabled ? 'DeepSeek 已连接 · 支持中英文自然语言' : '引导模式 · 可使用快捷操作'}}</text><text class="muted">商品、库存、价格和发货变更均需你审核并确认。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card"><text class="heading">{{me.account || 'Link your website account'}}</text><text class="muted">{{me.linked ? (me.is_seller ? 'Verified seller · connected to your shop' : 'Account linked · seller verification still needed') : 'No seller privileges are created by opening this Mini Program.'}}</text><text wx:if="{{me && !me.is_seller}}" class="muted">{{me.onboarding}}</text>
    <button wx:if="{{me && !me.linked}}" bindtap="beginLink" disabled="{{busy}}">Generate secure linking request</button><button bindtap="refreshSession" disabled="{{busy}}">Refresh connection</button><button bindtap="privacy">Privacy notice</button><button wx:if="{{me}}" bindtap="signOut" disabled="{{busy}}">Sign out and clear local consent</button>
    <view wx:if="{{link}}" class="link-box"><text>Code: {{link.verification_code}}</text><text class="muted">Open the copied link in your browser, sign in and enter this code. Expires in five minutes.</text><button bindtap="copyLink">Copy website link</button></view>
  </view>
  <view wx:if="{{me.linked}}">
    <view class="tabs"><button data-tab="chat" bindtap="setTab">Assistant</button><button data-tab="products" bindtap="setTab">Products</button><button data-tab="orders" bindtap="setTab">Orders</button></view>
    <view wx:if="{{tab === 'chat'}}">
      <view class="quick"><button data-text="my products" bindtap="quick" disabled="{{busy}}">My products</button><button data-text="my orders" bindtap="quick" disabled="{{busy}}">My orders</button><button data-text="low stock" bindtap="quick" disabled="{{busy}}">Low stock</button><button data-text="new listing" bindtap="quick" disabled="{{busy}}">New listing</button><button data-text="help me start selling" bindtap="quick" disabled="{{busy}}">Getting started</button></view>
      <view wx:for="{{messages}}" wx:key="index" class="card"><text class="role">你</text><text>{{item.text}}</text><view class="reply"><text class="role">{{item.response.engine === 'deepseek' ? 'DeepSeek 卖家助手' : '卖家助手 · 引导操作'}}</text><text wx:if="{{item.response.notice}}" class="muted">{{item.response.notice}}</text><text>{{item.response.reply}}</text></view></view>
      <view class="card"><text class="muted">例如：哪些订单待发货？把蓝色杯子的库存改成十二个。帮我创建一款新商品。</text><textarea value="{{text}}" bindinput="onText" maxlength="2000" placeholder="用自己的话描述商品或订单操作…"/><button class="primary" bindtap="send" disabled="{{busy}}">{{busy ? '处理中…' : '发送'}}</button><button bindtap="newConversation" disabled="{{busy}}">新对话</button><text wx:if="{{aiEnabled}}" class="muted">对话及必要商品、订单摘要会发送给 DeepSeek。请勿输入客户联系方式、地址或其他私人信息。</text></view>
      <view wx:for="{{changes}}" wx:key="id" class="card"><text class="heading">{{item.action}} · {{item.status}}</text><text class="preview">{{item.preview}}</text><button wx:if="{{item.canConfirm}}" class="primary" data-id="{{item.id}}" bindtap="confirmChange" disabled="{{busy}}">Review and confirm</button><text wx:if="{{item.result.message}}">{{item.result.message}}</text><button wx:if="{{item.result.url}}" data-path="{{item.result.url}}" bindtap="copyEditor">Copy product editor link</button></view>
    </view>
    <view wx:if="{{tab === 'products'}}"><view wx:for="{{products}}" wx:key="slug" class="card"><text class="heading">{{item.name}}</text><text>{{item.currency}} {{item.price}} · {{item.made_to_order ? 'Made to order' : item.quantity + ' available'}}</text><text class="muted">{{item.active ? 'Active' : 'Unpublished'}}</text><picker range="{{item.optionNames}}" value="{{item.optionIndex}}" data-index="{{index}}" bindchange="onOption"><view class="picker">{{item.optionNames[item.optionIndex]}}</view></picker><text class="label">New available quantity</text><input type="number" value="{{item.editQuantity}}" data-index="{{index}}" data-field="editQuantity" bindinput="onProductField"/><button data-index="{{index}}" data-action="stock" bindtap="prepareProduct" disabled="{{busy || item.made_to_order}}">Preview stock change</button><text class="label">New price</text><input type="digit" value="{{item.editPrice}}" data-index="{{index}}" data-field="editPrice" bindinput="onProductField"/><button data-index="{{index}}" data-action="price" bindtap="prepareProduct" disabled="{{busy}}">Preview price change</button><button data-path="{{item.url}}" bindtap="copyEditor">Copy product editor link</button></view><text wx:if="{{!products.length}}" class="muted">No products yet. Use the assistant to draft your first listing.</text></view>
    <view wx:if="{{tab === 'orders'}}"><view wx:for="{{orders}}" wx:key="uuid" class="card"><text class="heading">{{item.order_number}}</text><text>{{item.payment_status}} · {{item.fulfillment_status}}</text><view wx:for="{{item.items}}" wx:for-item="line" wx:key="id"><text>{{line.quantity}} × {{line.product_name}}</text></view><text>{{item.carrier}} {{item.tracking_number}}</text><input placeholder="Carrier" value="{{item.carrierInput}}" data-index="{{index}}" data-field="carrierInput" bindinput="onOrderField"/><input placeholder="Tracking number" value="{{item.trackingInput}}" data-index="{{index}}" data-field="trackingInput" bindinput="onOrderField"/><button data-index="{{index}}" bindtap="prepareShipment" disabled="{{busy || !item.canShip}}">Preview shipment</button></view><text wx:if="{{!orders.length}}" class="muted">No orders for your shop.</text></view>
  </view>
</view>
