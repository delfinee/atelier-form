page{background:#f4f6f2;color:#2c4538;font-size:28rpx}.page{padding:32rpx}.intro{padding:20rpx 0 28rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#839579}.title{font-size:48rpx;font-weight:600;line-height:1.3;margin:20rpx 0}text{display:block;line-height:1.7;overflow-wrap:anywhere}.muted{color:#7e8c77;font-size:24rpx;margin:12rpx 0}.card{padding:28rpx;border:1px solid #dde5d6;border-radius:20rpx;background:white;margin-bottom:24rpx}.heading{font-size:31rpx;font-weight:600;margin-bottom:12rpx}button{font-size:25rpx;border-radius:12rpx;margin-top:20rpx;background:#eef3e8;color:#376046}button.primary{background:#285b45;color:white}.error{background:#fff0e8;color:#a1573c;padding:22rpx;margin-bottom:24rpx;border-radius:14rpx}.tabs,.quick{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:20rpx}.tabs button,.quick button{flex:1;min-width:140rpx;margin:0;font-size:22rpx}.role{font-size:21rpx;color:#7b8e71;margin-bottom:8rpx}.reply{background:#f1f5e9;padding:22rpx;margin-top:22rpx;border-radius:12rpx}.preview{white-space:pre-wrap;font-size:23rpx;background:#f6f8f1;padding:20rpx;margin:18rpx 0}input,textarea,.picker{box-sizing:border-box;border:1px solid #dbe4d4;padding:18rpx;border-radius:10rpx;margin:16rpx 0;background:#fff;font-size:27rpx}textarea{width:100%;height:160rpx}.label{font-size:24rpx;color:#7e8c77}.link-box{background:#edf4e5;padding:20rpx;margin-top:20rpx;border-radius:12rpx}
