# Copy to deploy/.env.production; never commit or share the completed file.
APP_DOMAIN=REPLACE_REGISTERED_DOMAIN
SELLER_PUBLIC_ORIGIN=https://REPLACE_REGISTERED_DOMAIN
ACME_EMAIL=REPLACE_CERTIFICATE_EMAIL
SELLER_OPERATOR=REPLACE_ACTUAL_OPERATOR_NAME
SELLER_CONTACT_EMAIL=REPLACE_PUBLIC_SUPPORT_EMAIL
POSTGRES_PASSWORD=REPLACE_RANDOM_URLSAFE_PASSWORD
DJANGO_SECRET_KEY=REPLACE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
WECHAT_APP_ID=wx8cb01bd3c9f16e2a
WECHAT_APP_SECRET=REPLACE_SERVER_ONLY_APPSECRET
# Never enable developer login or external LLM processing in this release.
WECHAT_SELLER_ENABLED=1
WECHAT_SELLER_DEV_LOGIN=0
SELLER_AGENT_USE_LLM=0
BUYER_ASSISTANT_ENABLED=1
BUYER_AI_USE_LLM=0
DJANGO_DEBUG=0
CURRENCY=SGD
# Optional build-time package mirror; the default is the official PyPI index.
PIP_INDEX_URL=https://pypi.org/simple
